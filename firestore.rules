rules_version = '2';

// Firestore Security Rules for Codex Sign-In Manager
// Each authenticated user can only read/write their own document.
// Deploy these rules via: Firebase Console → Firestore → Rules
// Or via CLI: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user gets exactly one document: /users/{userId}
    // Only the authenticated owner can read or write their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Block all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
